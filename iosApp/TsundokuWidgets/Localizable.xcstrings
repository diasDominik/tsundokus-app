    "How many arrived volumes are waiting to be read.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Колко пристигнали тома чакат да бъдат прочетени."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik doručených svazků čeká na přečtení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange modtagne bind der venter på at blive læst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele angekommene Bände noch ungelesen sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσοι τόμοι που έφτασαν περιμένουν να διαβαστούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántos tomos recibidos esperan a ser leídos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitu saabunud köidet ootab lugemist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Montako saapunutta osaa odottaa lukemista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de tomes reçus attendent d'être lus."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko primljenih svezaka čeka da bude pročitano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hány megérkezett kötet vár olvasásra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanti volumi arrivati aspettano di essere letti."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiek gautų tomų laukia skaitymo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cik saņemto sējumu gaida, lai tos izlasītu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel ontvangen delen nog gelezen moeten worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile dostarczonych tomów czeka na przeczytanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos volumes recebidos estão à espera de ser lidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câte volume sosite așteaptă să fie citite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Koľko doručených zväzkov čaká na prečítanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko prejetih zvezkov čaka na branje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
