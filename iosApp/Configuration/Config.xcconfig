TEAM_ID=

PRODUCT_NAME=TsundokuApp
APP_BUNDLE_IDENTIFIER=uk.tsundokus.app.TsundokuApp$(TEAM_ID)
PRODUCT_BUNDLE_IDENTIFIER=$(APP_BUNDLE_IDENTIFIER)

// Shared by the app and its widget extension (entitlements and Info.plist of both): the app writes
// the widget snapshot into this container, the widgets read it. Suffixed like the bundle identifier,
// so each team signs its own; Xcode registers it on the first automatically signed device build.
TSUNDOKU_APP_GROUP=group.uk.tsundokus.app$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0