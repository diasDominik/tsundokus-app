<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Reschedules reminders when the time zone or clock changes. Both broadcasts are exempt from
             the background limits on implicit broadcasts, so a manifest receiver still gets them. -->
        <receiver
            android:name="uk.tsundokus.features.orders.presentation.reminders.ReminderRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets. They only read the snapshot the app writes (GlanceWidgetPublisher). -->
        <receiver
            android:name="uk.tsundokus.features.orders.presentation.widgets.NextArrivalsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_next_arrivals_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_arrivals_info" />
        </receiver>
        <receiver
            android:name="uk.tsundokus.features.orders.presentation.widgets.PileWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_pile_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pile_info" />
        </receiver>
    </application>

</manifest>
