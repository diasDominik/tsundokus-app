<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG builds only. Permits cleartext (http://) to any host so the app can talk to a local dev
  server over the LAN (physical device), the emulator alias 10.0.2.2, or localhost — no per-IP edits.
  Release builds use the default policy (cleartext blocked).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
